<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/item_container"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txt_featured"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_featured"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_gravity="center"
            android:background="@color/narandzasta_tamnija"
            android:visibility="gone"
            />
        <ImageView
            android:id="@+id/img_event"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <TextView
            android:id="@+id/txt_event_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:layout_weight="1"
            android:gravity="start"
            />
        <TextView
            android:id="@+id/txt_category"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textColor="@color/ljubicasta_tamnija"
            android:layout_weight="1"
            android:gravity="start"
            />
        <TextView
            android:id="@+id/txt_location"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textColor="@color/siva"
            android:layout_weight="1"
            android:gravity="start"
            />
        <TextView
            android:id="@+id/txt_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textColor="@color/siva"
            android:layout_weight="1"
            android:gravity="start"
            />
        <!--android:visibility="gone"-->
        <TextView
            android:id="@+id/txt_capacity"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textColor="@color/narandzasta_tamnija"
            android:layout_weight="1"
            android:textStyle="bold"
            android:gravity="start"
            />
    </LinearLayout>

</LinearLayout>
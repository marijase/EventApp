<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RegisterActivity"
    >
    <include layout="@layout/header"></include>

    <!-- prvi red (username) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/rgs_username"
            android:gravity="center_vertical"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            >
        </TextView>
        <EditText
            android:id="@+id/id_rgs_username"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/rgs_username"
            android:layout_weight="1"
            android:textSize="17sp"
            >
        </EditText>
    </LinearLayout>

    <!-- drugi red (email) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/rgs_email"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            >
        </TextView>
        <EditText
            android:id="@+id/id_rgs_email"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/rgs_email"
            android:textSize="17sp"
            >
        </EditText>
    </LinearLayout>

    <!-- treci red (password) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/rgs_password"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:textSize="18sp"
            >
        </TextView>
        <EditText
            android:id="@+id/id_rgs_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/rgs_password"
            android:textSize="17sp"
            >
        </EditText>
    </LinearLayout>

    <Button
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:backgroundTint="@color/ljubicasta_tamnija"
        android:text="@string/rgs_button"
        android:textSize="15sp"
        android:layout_gravity="center_horizontal"
        >
    </Button>

</LinearLayout>
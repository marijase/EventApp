<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ProfileActivity">
    <include layout="@layout/header"></include>

    <TextView
        android:id="@+id/id_profile_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ispisace se username"
        android:gravity="center"
        android:textColor="@color/siva"
        android:textSize="18sp"
        android:paddingTop="10dp"
        >
    </TextView>

    <TextView
        android:id="@+id/id_profile_mail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ispisace se mejl"
        android:gravity="center"
        android:textColor="@color/siva"
        android:textSize="16sp"
        android:paddingBottom="30dp"
        >
    </TextView>
    <Button
        android:id="@+id/id_btn_change_password"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/ljubicasta_svetlija"
        android:text="@string/btn_change_password"
        android:textSize="14sp"
        >
    </Button>
    <Button
        android:id="@+id/id_btn_end_sesion"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/ljubicasta_tamnija"
        android:text="@string/end_session"
        android:textSize="16sp"
        >
    </Button>

</LinearLayout>
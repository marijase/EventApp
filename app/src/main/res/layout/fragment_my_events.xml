<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MyEventsFragment"
    android:background="@color/siva_svetlija"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        >
        <Button
            android:id="@+id/id_interested"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/interested"
            android:textSize="12sp"
            android:backgroundTint="@color/ljubicasta_tamnija"
            >
        </Button>
        <Button
            android:id="@+id/id_attending"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/ljubicasta_tamnija"
            android:text="@string/attending"
            android:textSize="12sp"
            >
        </Button>
    </LinearLayout>
    <Button
        android:id="@+id/id_profile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="@color/ljubicasta_tamnija"
        android:text="@string/my_profile"
        >
    </Button>


</LinearLayout>
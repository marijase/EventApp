<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/item_container"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txt_featured"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_featured"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_gravity="center"
            android:background="@color/narandzasta_tamnija"
            android:visibility="gone"/>
        <ImageView
            android:id="@+id/img_event"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"/>
    </LinearLayout>

    <!-- new: layout_width="0dp" i layout_weight="1" da ne gura dugme van ekrana -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        >
        <TextView
            android:id="@+id/txt_event_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/txt_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/ljubicasta_tamnija"
            />
        <TextView
            android:id="@+id/txt_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/siva"
            />
        <TextView
            android:id="@+id/txt_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/siva"
            />
        <TextView
            android:id="@+id/txt_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:textColor="@color/narandzasta_tamnija"
            android:textStyle="bold"
            />
    </LinearLayout>

    <!-- new: layout_gravity="center_vertical" da bude vertikalno centriran -->
    <Button
        android:id="@+id/btn_rate_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="@string/btn_oceni"
        android:visibility="gone"
        android:backgroundTint="@color/ljubicasta_tamnija"
        android:textColor="@color/white"/>

</LinearLayout>